# Sponsor (fee payer) private key, hex. Fund its address with STX on each network you serve.
SPONSOR_PRIVATE_KEY=
# Comma-separated merchant addresses eligible for sponsored fees; empty disables sponsorship.
SPONSOR_PAY_TO=
# Optional Hiro API key (sent as x-api-key); recommended to raise rate limits.
HIRO_API_KEY=
# Maximum sponsor fees in microSTX per merchant per UTC day
SPONSOR_DAILY_BUDGET=1000000
# Maximum sponsored settles per payer in a rolling minute
SPONSOR_PAYER_PER_MINUTE=10
# JSON file for persisted daily sponsor fee counters
STATE_FILE=./data/state.json
# Low sponsor STX balance threshold in microSTX
SPONSOR_LOW_BALANCE=1000000
# Optional low-balance alert webhook
ALERT_WEBHOOK_URL=
# Port (8085 matches the x402-stacks SDK default facilitatorUrl)
PORT=8085
# Flat sponsor fee per tx in microSTX
SPONSOR_FEE=10000
# Maximum fee for a stuck sponsor nonce replacement; defaults to SPONSOR_FEE * 16
SPONSOR_MAX_REPAIR_FEE=160000
# Max time /settle waits for confirmation; keep below the SDK's 50s HTTP timeout
SETTLE_TIMEOUT_MS=45000
